{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>sublimelsp/renovate-preset",
    "github>sublimelsp/renovate-preset:automerge-server"
  ],
  "npm": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchManagers": [
        "pep621"
      ],
      "matchPackageNames": [
        "esphome"
      ],
      "separateMajorMinor": false,
      "commitMessageExtra": "to v{{{prettyNewVersion}}}",
      "description": "Versions are release dates, so a new year isn't a breaking change: automerge every update, not only patch and minor ones.",
      "automerge": true
    }
  ]
}
